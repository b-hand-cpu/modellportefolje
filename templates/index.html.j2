<!DOCTYPE html>
<html lang="nb">
<head>
    <meta charset="UTF-8">
    <title>Modellportefølje</title>
    <script src="https://cdn.plot.ly/plotly-2.35.2.min.js"></script>
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            max-width: 900px;
            margin: 2rem auto;
            padding: 0 1rem;
            color: #222;
            line-height: 1.5;
        }
        h1 { border-bottom: 2px solid #222; padding-bottom: 0.5rem; }
        .undertittel { color: #666; margin-bottom: 2em; }
        #graf { margin: 2rem 0 3rem; }
        table {
            border-collapse: collapse;
            width: 100%;
            margin-bottom: 2rem;
        }
        th, td {
            padding: 8px 12px;
            text-align: right;
            border-bottom: 1px solid #eee;
        }
        th:first-child, td:first-child { text-align: left; }
        th { background: #f5f5f5; }
        .positiv { color: #0a7d2f; }
        .negativ { color: #c0392b; }
        details {
            border: 1px solid #ddd;
            border-radius: 4px;
            margin-bottom: 0.5rem;
            padding: 0.75rem 1rem;
        }
        details[open] { background: #fafafa; }
        summary {
            cursor: pointer;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        summary .ticker { color: #666; font-weight: 400; margin-left: 0.5rem; }
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 0.5rem 1.5rem;
            margin: 1rem 0;
            padding: 0.75rem;
            background: #f4f4f4;
            border-radius: 4px;
            font-size: 0.9rem;
        }
        .stat-label { color: #666; font-size: 0.8rem; }
        .stat-value { font-weight: 600; }
        .tese { margin-top: 1rem; }
        .tese h2 { font-size: 1.1rem; margin-top: 1rem; }
        .metodikk { margin-top: 3rem; }
        .disclaimer { color: #888; font-size: 0.85rem; }
        footer { color: #888; font-size: 0.85rem; margin-top: 3rem; }
    </style>
</head>
<body>
    <h1>Modellportefølje</h1>
    <p class="undertittel">Oslo Børs · likevektet · vs OSEBX</p>

    <div id="graf"></div>

    <h2>Aksjer i porteføljen</h2>
    <table id="tabell">
        <thead>
            <tr>
                <th>Ticker</th>
                <th>Inn</th>
                <th>Kurs inn</th>
                <th>Siste kurs</th>
                <th>Uken</th>
                <th>Siden inntak</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <h2>Aksjetese og nøkkeltall</h2>
    {% for stock in stocks %}
    <details id="{{ stock.ticker.split('.')[0] }}">
        <summary>
            {{ stock.navn }}<span class="ticker">{{ stock.ticker }} · {{ stock.sektor }}</span>
        </summary>
        <div class="stats">
            <div><div class="stat-label">Kurs</div><div class="stat-value">{{ stock.stats.kurs }}</div></div>
            <div><div class="stat-label">Markedsverdi</div><div class="stat-value">{{ stock.stats.markedsverdi }}</div></div>
            <div><div class="stat-label">P/E</div><div class="stat-value">{{ stock.stats.pe }}</div></div>
            <div><div class="stat-label">Utbytte</div><div class="stat-value">{{ stock.stats.dividend_yield }}</div></div>
            <div><div class="stat-label">52u høy</div><div class="stat-value">{{ stock.stats.hoy_52u }}</div></div>
            <div><div class="stat-label">52u lav</div><div class="stat-value">{{ stock.stats.lav_52u }}</div></div>
        </div>
        <div class="tese">
            {{ stock.body_html | safe }}
        </div>
    </details>
    {% endfor %}

    <section class="metodikk">
        <h2>Metodikk</h2>
        <p>
            Porteføljen er likevektet slik at hver aksje har lik vekt uansett antall
            aksjer i porteføljen. Inn- og utkurs baseres på sluttkurs den dagen aksjen tas inn i
            eller ut av porteføljen. Første avkastningsdag er dagen etter inntak, altså
            endringen fra inntaksdato til dagen etter.
            Prisdata hentes fra Yahoo Finance og er justert for utbytte og aksjesplitter.
            Benchmark er <strong>OSEBX</strong>. Avkastning måles i norske kroner og inkluderer ikke
            transaksjonskostnader eller skatt.
        </p>
        <p class="disclaimer">
            Dette er et personlig prosjekt for læringsformål og utgjør ikke investeringsråd.
        </p>
    </section>

    <footer>
        Sist oppdatert: {{ build_time }} · Data: yfinance
    </footer>

    <script>
        // Enkel CSV-parser: splitt på linjeskift og komma
        function parseCSV(tekst) {
            const linjer = tekst.trim().split(/\r?\n/);
            const kolonner = linjer[0].split(",").map(s => s.trim());
            return linjer.slice(1).map(linje => {
                const verdier = linje.split(",").map(s => s.trim());
                const rad = {};
                kolonner.forEach((kol, i) => rad[kol] = verdier[i]);
                return rad;
            });
        }

        // Last ned og parse en CSV-fil
        async function lastCSV(sti) {
            const respons = await fetch(sti);
            const tekst = await respons.text();
            return parseCSV(tekst);
        }

        // Tegn grafen
        async function tegnGraf() {
            const data = await lastCSV("data/performance.csv");

            const datoer = data.map(r => r.dato);
            const portefolje = data.map(r => parseFloat(r.portefolje_kumulativ));
            const osebx = data.map(r => parseFloat(r.osebx_kumulativ));

            const spor = [
                {
                    x: datoer,
                    y: portefolje,
                    name: "Portefølje",
                    type: "scatter",
                    mode: "lines",
                    line: { color: "#1a4d3a", width: 3 },
                    marker: { color: "#1a4d3a", size: 5 }
                },
                {
                    x: datoer,
                    y: osebx,
                    name: "OSEBX",
                    type: "scatter",
                    mode: "lines",
                    line: { color: "#c65d3e", width: 3 },
                    marker: { color: "#c65d3e", size: 5 }
                }
            ];

            const layout = {
                title: {
                    text: "Kumulativ avkastning siden start",
                    font: { size: 16, color: "#222", family: "-apple-system, BlinkMacSystemFont, sans-serif" }
                },
                xaxis: {
                    title: "",
                    showgrid: false,
                    showline: true,
                    linecolor: "#333",
                    tickfont: { color: "#666", size: 11 }
                },
                yaxis: {
                    title: { text: "Avkastning (%)", font: { size: 12, color: "#666" } },
                    zeroline: true,
                    zerolinecolor: "#999",
                    zerolinewidth: 1,
                    showline: true,
                    linecolor: "#333",
                    gridcolor: "#d0d0d0",
                    tickfont: { color: "#666", size: 11 },
                    ticksuffix: "%"
                },
                hovermode: "x unified",
                hoverlabel: {
                    bgcolor: "white",
                    bordercolor: "#ddd",
                    font: { size: 12 }
                },
                legend: {
                    x: 0.02,
                    y: 0.98,
                    bgcolor: "rgba(255,255,255,0.9)",
                    bordercolor: "#eee",
                    borderwidth: 1,
                    font: { size: 12 }
                },
                margin: { t: 60, r: 30, b: 40, l: 60 },
                plot_bgcolor: "white",
                paper_bgcolor: "white",
                shapes: [
                    {
                        type: "line",
                        xref: "paper",
                        yref: "paper",
                        x0: 0, x1: 1,
                        y0: 1, y1: 1,
                        line: { color: "#333", width: 1 }
                    }
                ]
            };

            Plotly.newPlot("graf", spor, layout, {
                responsive: true,
                displayModeBar: false  // fjerner Plotly-verktøylinjen øverst
            });
        }

        // Fyll tabellen
        async function fyllTabell() {
            const data = await lastCSV("data/per_aksje.csv");
            const tbody = document.querySelector("#tabell tbody");

            data.forEach(rad => {
                const avk = parseFloat(rad.avkastning_pct);
                const uke = rad.uke_avkastning_pct ? parseFloat(rad.uke_avkastning_pct) : null;

                const totalKlasse = avk >= 0 ? "positiv" : "negativ";
                const totalFortegn = avk >= 0 ? "+" : "";

                const ukeCell = uke !== null
                    ? `<td class="${uke >= 0 ? "positiv" : "negativ"}">${uke >= 0 ? "+" : ""}${uke.toFixed(2)}%</td>`
                    : `<td>—</td>`;

                tbody.innerHTML += `
                    <tr>
                        <td><strong>${rad.ticker.replace(".OL", "")}</strong></td>
                        <td>${rad.inn_dato}</td>
                        <td>${rad.kjopskurs}</td>
                        <td>${rad.sistekurs}</td>
                        ${ukeCell}
                        <td class="${totalKlasse}">${totalFortegn}${avk.toFixed(2)}%</td>
                    </tr>
                `;
            });
        }

        tegnGraf();
        fyllTabell();
    </script>
</body>
</html>
